// ============================================================
// Модуль: реализация динамического массива (Array) с проверкой границ
// Язык: собственный (синтаксис похож на смесь C++/Rust/JavaScript)
// ============================================================

// Макрос для проверки выхода индекса за пределы массива.
// Если index >= size, генерирует assertion с сообщением об ошибке.
#macro IS_OUT_OF_SIZE(index, size) {
    if (index >= size) assert false, "out of array size (" + String(size) + String(")");
}

// Структура, представляющая массив элементов фиксированного размера.
// Элементы хранятся в непрерывной области памяти, тип элемента задаётся при создании.
struct Array {
    // Статический блок — инициализируется один раз для всего типа.
    static {
        // _type хранит тип элементов массива (используется для проверок и преобразований).
        global shadow let _type: Type = Null;
        // T — тип самого конструктора (ссылка на Array).
        global shadow let T: Type = typeof(Array);
        // Указатель на начало выделенной памяти.
        let _start: ptr?;
        // Размер массива (количество элементов).
        let _size: Int = 0;

        // Вспомогательный счётчик для метода append (текущая позиция вставки).
        let _at_index: Int = 0;
    }

    // Конструктор: выделяет память под size элементов заданного типа.
    // Возвращает экземпляр Array.
    func __init__(size: Int, type: Type) -> T {
        this._size = size;
        this._type = type;
        
        this._start = this.alloc();   // вызов внутреннего метода выделения памяти
        
        ret this;
    }

    // Деструктор (вызывается при уничтожении объекта).
    // Пока просто выводит сообщение.
    func __del__() -> Null {
        for (let i = 0; i < this._size; ++i;) {
            del *(this._start + i);
        }
    }

    // Преобразование массива в строку: элементы перечисляются через запятую.
    func __str__() -> String {
        let res_string = String("[");
        for (let i = 0; i < this._size; ++i;) {
            // Чтение элемента по адресу (_start + i) и преобразование в строку
            if (typeof(*(this._start + i)) == T) res_string = res_string + "...";
            else res_string = res_string + String(*(this._start + i));
            if (i != this._size - 1) res_string = res_string + ", ";
        }
        res_string = res_string + String("]");
        ret res_string;
    }

    // Получение элемента по индексу с проверкой границ.
    func get(index: Int) -> _type {
        IS_OUT_OF_SIZE(index, this._size)
        ret *(this._start + index);
    }

    // Запись элемента по индексу с проверкой границ.
    // Возвращает сам массив (для цепочечных вызовов).
    func set(index: Int, value: _type) -> T {
        IS_OUT_OF_SIZE(index, this._size)
        *(this._start + index) = value;
        ret this;
    }

    func get_ptr(index: Int) -> ptr {
        IS_OUT_OF_SIZE(index, this._size)
        ret (this._start + index);
    }

    // Внутренний метод выделения памяти под массив.
    // ВАЖНО: используется "хитрая" стратегия: сначала получаем указатель на 3 байта/слота
    // после new null, затем в цикле создаём size "пустых" объектов (new null).
    // Так эмулируется выделение массива нужного размера.
    func alloc() -> ptr {
        let p = (new null) + 3;
        for (let i = 0; i < this._size; ++i;) {
            
            new <static(this._type | Null)> null;
        }
        ret p;
    }

    // Добавление элемента в конец массива (с использованием внутреннего счётчика _at_index).
    // Если _at_index достиг _size, возникает ошибка (IS_OUT_OF_SIZE).
    // После добавления счётчик увеличивается.
    func append(value: _type) -> Null {
        IS_OUT_OF_SIZE(this._at_index, this._size)
        *(this._start + this._at_index) = value;
        ++this._at_index;
    }

    
}


