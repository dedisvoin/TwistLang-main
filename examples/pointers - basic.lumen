// для того чтобы получить адрес переменной необходимо использовать оператор &
//! адресс можно получить только у переменных

let name = "Ivan";
let name_ptr = &name;
echo name_ptr;

// через указатель можно взаимодействовать с значением переменной
*name_ptr = true;
echo *name_ptr;


// модификаторы которые были указаны при декларации переменной влияют именно на значение а не на саму
// переменную в этом можно убедиться.

const let PI = 3.14;
let p_ptr = &PI;

//! *p_ptr = 10; // ошибка

// при помощи оператора new можно динамически создавать значения в памяти
let a = new "Test"; //? выделяет в памяти ячейку и помещает туда строку

// при динамическом создании можно применить два модификатора
let p = new<static(Int), const> 100; // выделяет статическую константную ячейку


let pp = &p; // указатель на указатель
echo **pp; // разыменовываем два раза

//! **p = 10; попытка присваения вызовет ошибку (const)

// указательные типы создаются * перед типом
//? *Int - указатель на Int
//? ***Int - тройной указатель на Int
//? *auto - тип для любого одинарного указательного типа 
//? **auto - тип для любого двойного указательного типа

//static let my_ptr: **String = new "Hello, World"; // выйдет ошибка неверного типа
static let my_ptr: **String = new new "Hello, World"; // выделяем два раза память
                                                      // один для указателя другой
                                                      // для самого значения

