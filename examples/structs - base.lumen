
// Базовый пример структуры
struct Vector2D {
    static {
        global shadow let Number: Type = Int | Double;
        global shadow let T: Type = typeof(Vector2D);
        let x: *Number? = new 0;
        let y: *Number? = new 0;

        let g: auto?;
        let c: auto?;
    }

    func __init__(x: Number = 0, y: Number = 0) -> T {
        *this.x = x;
        *this.y = y;
        ret this;
    }

    
    func __str__() -> String {
        ret "Vector2D: " + String(*this.x) + ", " + String(*this.y);
    }
}


let v1 = Vector2D(1.0, 20.4);


echo *(v1.x);




