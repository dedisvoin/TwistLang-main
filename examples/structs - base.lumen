
// Базовый пример структуры
struct Person {
    static {
        let name: String?;
        let age: Int?;
    }

    func __init__(name: String, age: Int) -> typeof(Person) { // конструктор
        this.name = name;
        this.age = age;
        outln "created";
        ret this;
    }

    func __del__() -> Null { // деструктор
        outln "deleted";
    }


    func p_echo() -> Null {
        echo "Name: " + this.name + ", Age: " + String(this.age);
    }
}

let person_1 = Person("Ivan", 19);


person_1.p_echo();

let pt = &person_1;

del *pt;


















