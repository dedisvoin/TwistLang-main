//? при помощи ptr мы можем динамически создавать указатели по указанным адресам

new 10; // выделям ячейки под три значение но не сохраняем указатели
new 20;
new 30;

// с 0 до 13 ячейку зарезревированы
// при new 10 следующая ячейка (14) занимается 10 и так далее
let p = ptr(14);
echo *p;
// p будет указателем на Null (неизвестный тип)

let get = lambda(a: *Int) -> Int {*a};

//! echo get(p); // будет ошибка

// при создании указателя мы можем сразу задать его тип
let p = ptr(14, Int);

echo get(p + 1); // ошибки не будет


// при помощи указателей можно перемещаться по ленте памяти

let start = 0;
let start_ptr = &start + 2; // следующая ячейка после start
let a = "Ivan";
let b = true;
let c = 'c';
let d = null;
let e = get;

for (let i = 0; i < 7; i = i + 1;) {
    outln *(start_ptr + i);
}

// выведутся два странных значения
// ...
// 5
// null

// 5 это значение переменной i на момент ображения к ней через указатель
// null вернется при попытке чтения еще не созданной ячйки

